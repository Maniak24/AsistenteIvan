<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#34333F" />
            <stroke
                android:width="1dp"
                android:color="#7160B8" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="#222229" />
            <stroke
                android:width="1dp"
                android:color="#3A3A46" />
        </shape>
    </item>

</selector>
