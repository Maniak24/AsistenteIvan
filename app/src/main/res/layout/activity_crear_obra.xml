<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva obra"
            android:textColor="#1B5E20"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreObra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Nombre de la obra" />

        <EditText
            android:id="@+id/etUbicacionObra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Ubicación" />

        <EditText
            android:id="@+id/etDescripcionObra"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Descripción"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/etEstadoObra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Estado: Planificada, En ejecución, Finalizada..." />

        <EditText
            android:id="@+id/etAvanceObra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Avance (%)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnGuardarObra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PUBLICAR OBRA" />

    </LinearLayout>

</ScrollView>
