<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo trámite"
            android:textColor="#1B5E20"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreTramite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Nombre del trámite" />

        <EditText
            android:id="@+id/etDescripcionTramite"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Descripción"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/etRequisitosTramite"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Requisitos"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/etHorarioTramite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Horario de atención" />

        <EditText
            android:id="@+id/etContactoTramite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Teléfono / contacto" />

        <Button
            android:id="@+id/btnGuardarTramite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PUBLICAR TRÁMITE" />

    </LinearLayout>

</ScrollView>
