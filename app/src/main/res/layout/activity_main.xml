<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        
        <TextView
            android:id="@+id/btnPanelMunicipal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1B5E20"
            android:gravity="center"
            android:padding="18dp"
            android:text="PANEL MUNICIPAL"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

<TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Colonia Victoria"
            android:textColor="#1B5E20"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Servicios municipales"
            android:textColor="#555555"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnReclamo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="#1B5E20"
            android:gravity="center"
            android:text="HACER UN RECLAMO"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Servicios"
            android:textColor="#222222"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnNoticias"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="📰  Noticias y avisos"
                android:textColor="#222222"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnObras"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="🏗  Obras municipales"
                android:textColor="#222222"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnMapa"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="📍  Mapa de reclamos"
                android:textColor="#222222"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnTramites"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:text="📅  Turnos y trámites"
                android:textColor="#222222"
                android:textSize="17sp" />

        </LinearLayout>


        <TextView
            android:id="@+id/btnMisReclamos"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:text="Mis reclamos"
            android:textColor="#222222"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Colonia Victoria informa"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Información oficial, servicios y novedades de la localidad."
            android:textColor="#666666"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
