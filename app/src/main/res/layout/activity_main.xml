<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_premium">

    <View
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-55dp"
        android:layout_marginEnd="-70dp"
        android:background="@drawable/shape_orange" />

    <View
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-70dp"
        android:layout_marginStart="-70dp"
        android:background="@drawable/shape_blue" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="28dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.ivan.mipc2.MiPcLogoView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Logo de Mi PC" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MI PC"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tu asistente inteligente"
                        android:textColor="#8F96A8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_header_button"
                android:contentDescription="Menú"
                android:padding="13dp"
                android:src="@drawable/ic_menu" />
        </LinearLayout>

        <!-- ESTADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ai_status"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/dot_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MI PC"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gguf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IA online · Gemini"
                    android:textColor="#858CA0"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/connection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN LÍNEA"
                android:textColor="#76D900"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CHAT -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:scrollbars="vertical" />

            <com.ivan.mipc2.IntroRobotView
                android:id="@+id/intro_robot"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:alpha="0.75" />
        </FrameLayout>


    <!-- MENU LATERAL -->
    <LinearLayout
        android:id="@+id/side_menu"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_side_menu_premium"
        android:elevation="30dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical">

            <com.ivan.mipc2.MiPcLogoView
                android:layout_width="42dp"
                android:layout_height="42dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="MI PC"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_close_menu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_header_button"
                android:contentDescription="Cerrar"
                android:padding="12dp"
                android:src="@drawable/ic_close" />
    

<LinearLayout
            android:id="@+id/composer"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_premium"
            android:gravity="center_vertical"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <ImageButton
                android:id="@+id/btn_mic"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="Micrófono"
                android:padding="12dp"
                android:src="@drawable/ic_mic" />

            <EditText
                android:id="@+id/user_input"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Escribile a Mi PC..."
                android:imeOptions="actionSend|flagNoExtractUi"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#737A8C"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_call"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Conversación por voz"
                android:padding="11dp"
                android:src="@drawable/ic_call" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Enviar"
                android:src="@drawable/ic_send"
                app:backgroundTint="#0097FE"
                app:elevation="5dp"
                app:maxImageSize="21dp" />
        </LinearLayout>
    </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#242A38" />

        <TextView
            android:id="@+id/menu_new_chat"
            style="@style/MiPcMenuItem"
            android:text="✦   Nuevo chat" />

        <TextView
            android:id="@+id/menu_files"
            style="@style/MiPcMenuItem"
            android:text="▱   Archivos" />

        <TextView
            android:id="@+id/menu_catalog"
            style="@style/MiPcMenuItem"
            android:text="▦   Catálogo" />

        <TextView
            android:id="@+id/menu_history"
            style="@style/MiPcMenuItem"
            android:text="◷   Historial" />

        <TextView
            android:id="@+id/menu_settings"
            style="@style/MiPcMenuItem"
            android:text="⚙   Configuración" />

        <!-- IDs heredados -->
        <TextView
            android:id="@+id/btnInformacion"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnPanelMunicipal"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnTramites"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnMapa"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnObras"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnNoticias"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnMisReclamos"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnReclamo"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="1dp" />

    </LinearLayout>

</FrameLayout>
