<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/voice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MI PC"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tu asistente inteligente"
            android:textColor="#9D9DA8"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/voice_orb_container"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginTop="95dp"
            android:gravity="center">

            <View
                android:id="@+id/voice_orb_glow"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:background="@drawable/bg_voice_orb_glow" />

            <View
                android:id="@+id/voice_orb"
                android:layout_width="155dp"
                android:layout_height="155dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_voice_orb" />

            <TextView
                android:id="@+id/voice_orb_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚡"
                android:textColor="#FFFFFF"
                android:textSize="42sp" />

        </FrameLayout>

        <TextView
            android:id="@+id/voice_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:text="Escuchando…"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_hint"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Hablá normalmente. Mi PC te está escuchando."
            android:textColor="#8E8E99"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/voice_close"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_voice_close"
            android:contentDescription="Finalizar llamada"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Finalizar"
            android:textColor="#8E8E99"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
