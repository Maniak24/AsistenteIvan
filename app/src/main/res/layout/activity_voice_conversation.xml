<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="54dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MI PC"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Conversación por voz"
            android:textColor="#92929E"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/voice_orb_container"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_marginTop="82dp"
            android:gravity="center">

            <View
                android:id="@+id/voice_orb_glow"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_voice_orb_glow"
                android:alpha="0.72" />

            <View
                android:id="@+id/voice_orb"
                android:layout_width="164dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_voice_orb" />

        </FrameLayout>

        <TextView
            android:id="@+id/voice_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Escuchando…"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_hint"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Hablá normalmente. Mi PC escucha y responde automáticamente."
            android:textColor="#858592"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/voice_close"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_voice_close"
            android:contentDescription="Finalizar conversación"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF"
            android:padding="17dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Finalizar"
            android:textColor="#8E8E99"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
